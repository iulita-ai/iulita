{
  "openapi": "3.1.0",
  "info": {
    "title": "Iulita Mobile OAuth2 Wire Contract",
    "version": "1.2.0",
    "description": "HTTPS OAuth realm shared by independently registered native, CLI and service principals. Native uses S256 PKCE, CLI uses RFC8628 and P-256 installation proof, services use client_secret_basic and short-lived owner-bound chat scopes. All tokens require live persistent revocation and account checks."
  },
  "paths": {
    "/.well-known/oauth-authorization-server": {
      "get": {
        "operationId": "mobileOAuthMetadata",
        "responses": {
          "200": {
            "description": "Public AS metadata; no credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metadata"
                }
              }
            }
          }
        }
      }
    },
    "/oauth2/authorize": {
      "get": {
        "operationId": "mobileOAuthAuthorize",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "const": "code"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 512,
              "not": {
                "pattern": "[\\r\\n\\u0000]"
              }
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "const": "S256"
            }
          },
          {
            "name": "iulita_installation_key_thumbprint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "iulita_device_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "iulita_fresh_auth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Browser password form with an explicit subsequent consent page; no credentials or tokens in HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Local invalid-request HTML page; invalid redirects never receive a Location header",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Persistent request limit reached"
          }
        }
      }
    },
    "/oauth2/token": {
      "post": {
        "operationId": "mobileOAuthToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TokenResponse",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "OAuthError",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client authentication; service errors include WWW-Authenticate: Basic",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Persistent IP rate limit; retry after Retry-After seconds",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "503": {
            "description": "Temporary storage or grant capacity failure; no credentials issued",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        },
        "description": "Grant-specific request shapes. client_credentials requires one HTTP Basic Authorization header, forbids client_id/client_secret in the body, and returns no refresh token. Device polling requires the registered P-256 public JWK and respects authorization_pending, slow_down (+5 seconds), access_denied and expired_token.",
        "security": [
          {},
          {
            "serviceBasic": []
          }
        ]
      }
    },
    "/oauth2/revoke": {
      "post": {
        "operationId": "mobileOAuthRevoke",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RevocationForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revoked or unknown token; no existence leak"
          },
          "400": {
            "description": "OAuthError",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client authentication; service errors include WWW-Authenticate: Basic",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Persistent IP rate limit; retry after Retry-After seconds",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "503": {
            "description": "Temporary storage or grant capacity failure; no credentials issued",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "serviceBasic": []
          }
        ],
        "description": "Native/CLI: body client_id and token, no Authorization header. Service: token and optional token_type_hint only in body; one matching service HTTP Basic header required. Unknown tokens return 200; clients cannot revoke another registration."
      }
    },
    "/oauth2/jwks": {
      "get": {
        "operationId": "mobileOAuthJWKS",
        "responses": {
          "200": {
            "description": "Public signing keys only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SigningJWKS"
                }
              }
            }
          }
        }
      }
    },
    "/oauth2/login": {
      "post": {
        "operationId": "mobileOAuthBrowserLogin",
        "description": "Browser form only. Requires the Secure HttpOnly SameSite=Lax __Host-iulita_oauth_browser binding cookie, exact issuer Origin and flow-specific CSRF. Never accepts a dashboard JWT as password authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "flow_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "csrf": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  },
                  "username": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 72
                  }
                },
                "required": [
                  "flow_id",
                  "csrf",
                  "username",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Explicit consent page after password verification, or generic password form error"
          },
          "400": {
            "description": "Invalid/expired flow, CSRF or Origin"
          },
          "429": {
            "description": "Persistent login rate limit"
          }
        }
      }
    },
    "/oauth2/consent": {
      "post": {
        "operationId": "mobileOAuthBrowserConsent",
        "description": "Browser form only. Requires the Secure HttpOnly SameSite=Lax __Host-iulita_oauth_browser binding cookie, exact issuer Origin and flow-specific CSRF. Never accepts a dashboard JWT as password authentication. Device Flow requires retyped user_code and returns HTML 200; native authorization returns an exact registered callback 303. Forms are not interchangeable between flow types.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/UserConsentForm"
                  },
                  {
                    "$ref": "#/components/schemas/DeviceConsentForm"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Exact registered callback with code or access_denied, original state and issuer (iss), only after the transaction commits"
          },
          "400": {
            "description": "Invalid/expired/replayed consent, credential change or failed grant commit"
          },
          "403": {
            "description": "Account disabled or password change required"
          },
          "429": {
            "description": "Persistent consent rate limit"
          },
          "200": {
            "description": "Device Flow decision committed; return to originating console, no authorization redirect or bearer credentials in HTML"
          }
        }
      }
    },
    "/oauth2/device_authorization": {
      "post": {
        "operationId": "oauthDeviceAuthorization",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAuthorizationForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One-time device credentials; keep device_code secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAuthorizationResponse"
                }
              }
            }
          },
          "400": {
            "description": "OAuth error: invalid request/client policy/scope; no device code issued",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "429": {
            "description": "Persistent IP rate limit; retry after Retry-After seconds",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "503": {
            "description": "Temporary storage or grant capacity failure; no credentials issued",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth2/device": {
      "get": {
        "operationId": "oauthDeviceVerification",
        "description": "Browser form. Enter user_code, authenticate with password and CSRF-bound cookie, inspect registered app name/scopes and retype the console code. No automatic approval or cross-device refresh.",
        "parameters": [
          {
            "name": "user_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 9
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML verification or login form"
          },
          "400": {
            "description": "Invalid or expired code"
          }
        }
      }
    },
    "/oauth2/time": {
      "get": {
        "operationId": "mobileClockSample",
        "description": "TLS-authenticated nonce-bound runtime clock sample; no credentials required and no grant is issued. No-store; match clock_id to ServerInfo and SessionMirror; include resolution/error/RTT/drift/age in conservative expiry.",
        "security": [],
        "parameters": [
          {
            "name": "nonce",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh runtime sample",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeSample"
                }
              }
            }
          },
          "400": {
            "description": "Invalid nonce, method or issuer/TLS"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Clock discontinuity or slow sample; reject and resample"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InstallationJWK": {
        "type": "object",
        "properties": {
          "kty": {
            "const": "EC"
          },
          "crv": {
            "const": "P-256"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "y": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "kty",
          "crv",
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "family_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "key_thumbprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "purpose": {
            "enum": [
              "activate_device",
              "recover_device"
            ]
          },
          "expires_at": {
            "type": "integer",
            "minimum": 1
          },
          "nonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "signing_input": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "issuer",
          "owner_id",
          "client_id",
          "device_id",
          "family_id",
          "operation_id",
          "key_thumbprint",
          "purpose",
          "expires_at",
          "nonce",
          "signing_input"
        ],
        "additionalProperties": false
      },
      "TokenResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserTokenResponse"
          },
          {
            "$ref": "#/components/schemas/ServiceTokenResponse"
          }
        ]
      },
      "AccessClaims": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserAccessClaims"
          },
          {
            "$ref": "#/components/schemas/ServiceAccessClaims"
          }
        ]
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "authorization_endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "token_endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "revocation_endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "jwks_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "response_types_supported": {
            "type": "array",
            "items": {
              "const": "code"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "enum": [
                "authorization_code",
                "refresh_token",
                "urn:ietf:params:oauth:grant-type:device_code",
                "client_credentials"
              ]
            },
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true
          },
          "token_endpoint_auth_methods_supported": {
            "type": "array",
            "items": {
              "enum": [
                "none",
                "client_secret_basic"
              ]
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
          },
          "code_challenge_methods_supported": {
            "type": "array",
            "items": {
              "const": "S256"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "enum": [
                "chats:read",
                "chats:write",
                "devices:read",
                "devices:receive",
                "devices:sync",
                "devices:manage",
                "phone:data",
                "phone:ui",
                "assistant:services:read",
                "assistant:services:write"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "iulita_mobile_protocol_version": {
            "const": 1
          },
          "authorization_response_iss_parameter_supported": {
            "const": true
          },
          "device_authorization_endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "iulita_time_endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint",
          "revocation_endpoint",
          "jwks_uri",
          "response_types_supported",
          "grant_types_supported",
          "token_endpoint_auth_methods_supported",
          "code_challenge_methods_supported",
          "scopes_supported",
          "iulita_mobile_protocol_version",
          "authorization_response_iss_parameter_supported",
          "device_authorization_endpoint"
        ],
        "additionalProperties": false
      },
      "AuthorizationCodeForm": {
        "type": "object",
        "properties": {
          "grant_type": {
            "const": "authorization_code"
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "code_verifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{43,128}$"
          },
          "iulita_installation_jwk": {
            "type": "string",
            "contentMediaType": "application/json",
            "contentSchema": {
              "$ref": "#/components/schemas/InstallationJWK"
            }
          }
        },
        "required": [
          "grant_type",
          "client_id",
          "code",
          "redirect_uri",
          "code_verifier",
          "iulita_installation_jwk"
        ],
        "additionalProperties": false
      },
      "RefreshForm": {
        "type": "object",
        "properties": {
          "grant_type": {
            "const": "refresh_token"
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "refresh_token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "grant_type",
          "client_id",
          "refresh_token"
        ],
        "additionalProperties": false
      },
      "TokenForm": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthorizationCodeForm"
          },
          {
            "$ref": "#/components/schemas/RefreshForm"
          },
          {
