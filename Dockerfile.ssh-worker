FROM golang:1.27.2-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY internal ./internal
COPY cmd/ssh-worker ./cmd/ssh-worker
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -trimpath -o /ssh-worker ./cmd/ssh-worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 -h /nonexistent worker
COPY --from=builder /ssh-worker /usr/local/bin/ssh-worker
USER 10001:10001
ENTRYPOINT ["ssh-worker"]
